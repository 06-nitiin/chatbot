# Copy this file to .env for local development.
# Never commit .env or place real secret values in this file.

# Gemini API key for AI fallback responses.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Gemini model override.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Flask uses this key to sign session cookies.
# Generate one with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Use false for local HTTP development.
# Set true for HTTPS production deployments such as Render.
SESSION_COOKIE_SECURE=false
